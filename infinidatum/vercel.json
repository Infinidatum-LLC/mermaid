{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --no-audit --no-fund && cd .. && CYPRESS_INSTALL_BINARY=0 PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npx -y pnpm@10.30.3 install --frozen-lockfile",
  "buildCommand": "cd .. && npx -y pnpm@10.30.3 build:mermaid && cd infinidatum && node scripts/assemble.mjs",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/parse.mjs": { "maxDuration": 10, "includeFiles": "public/v/**/*.mjs" },
    "api/health.mjs": { "maxDuration": 10, "includeFiles": "public/v/**/*.mjs" },
    "api/oembed.mjs": { "maxDuration": 10 },
    "api/render.mjs": {
      "maxDuration": 30,
      "includeFiles": "{public/v/**/*.{mjs,js},node_modules/@sparticuz/chromium/bin/**}"
    }
  },
  "redirects": [{ "source": "/embed", "destination": "/latest/embed.html", "permanent": false }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/v/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/latest/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(.*)\\.(mjs|js)",
      "headers": [{ "key": "Content-Type", "value": "text/javascript; charset=utf-8" }]
    }
  ]
}
